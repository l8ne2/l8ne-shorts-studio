# Copie ce fichier en .env et remplis tes clés (ne jamais commit .env)
GROQ_API_KEY=
# Visuels : une seule clé suffit (Pixabay est utilisé en priorité s'il est renseigné)
PIXABAY_API_KEY=
PEXELS_API_KEY=
# Optionnel : forcer le fournisseur (pixabay ou pexels) / changer de modèle Groq
# VISUAL_PROVIDER=pixabay
# GROQ_MODEL=llama-3.3-70b-versatile
