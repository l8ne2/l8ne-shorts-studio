# Copie ce fichier en .env et remplis tes clés (ne jamais commit .env)
GROQ_API_KEY=
# Illustrations IA (styles animés) : compte Cloudflare gratuit, Workers AI
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Vidéos de stock : une seule clé suffit (Pixabay est utilisé en priorité s'il est renseigné)
PIXABAY_API_KEY=
PEXELS_API_KEY=
# Optionnel : forcer le fournisseur (pixabay ou pexels) / changer de modèle Groq
# VISUAL_PROVIDER=pixabay
# GROQ_MODEL=openai/gpt-oss-120b
